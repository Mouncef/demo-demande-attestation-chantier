# =============================================================================
# Variables d'environnement – copier ce fichier en `.env` (docker compose le lit
# automatiquement). Les valeurs ci-dessous sont des valeurs de DÉVELOPPEMENT :
# ne jamais les utiliser en production.
# =============================================================================

# --- Backend Django -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Clé secrète Django : OBLIGATOIRE et unique par environnement (>= 50 caractères).
DJANGO_SECRET_KEY=dev-only-change-me-9f2c1b7e4a6d8e0f1c3b5a7d9e2f4c6b8a0d1e3f5c7b9a2d4
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origines autorisées pour CORS / CSRF (le frontend est servi sur le port 8080).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# URL publique du frontend, utilisée dans les emails (liens vers les demandes).
FRONTEND_URL=http://localhost:8080
# URL publique du frontend, utilisée dans les emails (liens vers les demandes).
FRONTEND_URL=http://localhost:8080

# --- Base de données PostgreSQL ------------------------------------------------
POSTGRES_DB=attestations
POSTGRES_USER=attestations
POSTGRES_PASSWORD=attestations-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Email (Mailpit en dev : SMTP sur 1025, interface web sur http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=attestations-chantier@axa-demo.fr
# Boîte fonctionnelle du siège (facultatif : sinon email à chaque utilisateur SIEGE actif).
SIEGE_MAILBOX=

# --- Règles métier paramétrables ----------------------------------------------
# Délai minimal entre deux relances (heures) – règle du sujet : 24 h.
RELANCE_COOLDOWN_HOURS=24
# Délai après l'envoi avant la première relance possible (heures). 0 = immédiat (démo).
RELANCE_DELAI_INITIAL_HOURS=0
# Latence artificielle de l'analyse IA simulée (millisecondes), 0 pour désactiver.
IA_SIMULATED_DELAY_MS=800
# Taille maximale d'une pièce jointe (octets) – 10 Mo.
UPLOAD_MAX_BYTES=10485760

# --- Comptes de démonstration (créés au premier démarrage) ---------------------
SEED_DEMO_DATA=1
DEMO_PASSWORD=Axa-Demo-2026!

# --- Frontend (build Vite) -----------------------------------------------------
VITE_API_BASE_URL=/api/v1

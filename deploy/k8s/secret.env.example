# Copier ce fichier en deploy/k8s/secret.env (ignoré par git) puis `make k8s-secrets`.
# Clé secrète Django : aléatoire, plus de 50 caractères (ex. openssl rand -base64 64 | tr -d '\n').
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire-de-plus-de-50-caracteres
# Mot de passe PostgreSQL (ex. openssl rand -base64 24).
POSTGRES_PASSWORD=remplacer-mot-de-passe-postgres
# Mot de passe des comptes de démonstration.
DEMO_PASSWORD=Axa-Demo-2026!
# Identifiants de l'interface Mailpit (https://demo.zaghratmouncef.com/mailpit).
MAILPIT_USER=demo
MAILPIT_PASSWORD=remplacer-mot-de-passe-mailpit
